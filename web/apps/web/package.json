{
  "name": "@stuffcloud/web",
  "version": "0.0.0",
  "private": true,
  "description": "stuffcloud single-page app (Svelte + Vite, static build)",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run --coverage",
    "build": "vite build",
    "tokens": "node scripts/gen-tokens.ts --write",
    "tokens:check": "node scripts/gen-tokens.ts --check",
    "check-tools": "node scripts/check-tools.ts",
    "new-tool": "node scripts/new-tool.ts",
    "e2e:build": "vite build --config e2e/vite.config.ts",
    "e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@mozra-the-great/kern": "https://github.com/Mozra-the-great/kern/releases/download/v0.12.3/mozra-the-great-kern-0.12.3.tgz",
    "@stuffcloud/tools": "workspace:*",
    "diff": "^9.0.0",
    "dompurify": "^3.4.18",
    "jsqr": "^1.4.0",
    "marked": "^18.2.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "svelte": "^5.57.3",
    "uqr": "^0.1.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.10",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "4.14.0",
    "jsdom": "^31.0.1",
    "svelte-check": "^4.7.8",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
