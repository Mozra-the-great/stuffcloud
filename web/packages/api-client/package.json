{
  "name": "@stuffcloud/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed client for the stuffcloud API; the schema is generated from the OpenAPI document of `app`",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.1",
    "openapi-typescript": "^7.13.0",
    "vitest": "^5.1.1"
  }
}
