# Variables of the local development stack (compose.dev.yml).
#
# Optional: every variable has the default shown here, so `docker compose up` works without a
# `.env` file. To change one, copy this file to `.env` (git-ignored) and edit it.
#
# This file holds no secrets and must never get any. When the stack needs one (a mail
# password, an OIDC client secret, a DNS provider token), it comes from a file below
# `secrets/` (git-ignored) through the variable's `_FILE` variant, never from this file or
# the command line (SPEC section 11).
#
# Host names use the reserved `.localhost` suffix (RFC 6761): browsers resolve them to the
# loopback address, no DNS or hosts-file entry is needed. Use only reserved names here.

# Address the published ports bind to. Keep the loopback address: published Docker ports
# bypass the host firewall, and the dev stack has no authentication.
STUFFCLOUD_BIND=127.0.0.1

# Host port of the LAN listener (web app, placeholder sites, mail UI).
STUFFCLOUD_HTTP_PORT=8080

# Host port of Mailpit's SMTP server, for apps that run outside the stack.
STUFFCLOUD_SMTP_PORT=1025

# The app address: the web app (and later the API) is served here.
STUFFCLOUD_APP_HOST=stuff.localhost

# The site base: every `<name>.<site base>` is a (placeholder) site. A different registrable
# name than the app address, so app and sites are cross-site. Set it to the app address to try
# the shared-domain layout of ADR 0009.
STUFFCLOUD_SITES_BASE=sites.localhost

# Address of the Mailpit web UI.
STUFFCLOUD_MAIL_HOST=mail.localhost
