# Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.secret

# Claude Code — personal overrides, not shared
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# Node
node_modules/
npm-debug.log*
dist/
# End-to-end build and Playwright output (web/apps/web)
dist-e2e/
test-results/
playwright-report/
build/
coverage/

# Logs
*.log
logs/

# Archives / local build output
*.zip
*.tar.gz
tmp/

# Rust (fuzz/ has its own .gitignore)
/target/
mutants.out/
mutants.out.old/
lcov.info
*.profraw

# Python
__pycache__/
*.pyc
.venv/
.venv-lint/
.ruff_cache/

# Third-party design reference screenshots (copyrighted, local only)
/docs/reference-images/

# Local queue prompts and work files (never committed)
/Prompts & Claude/

# Throw-away app trees the web tests create (removed after each run)
/web/apps/web/.tmp-*/

# Local secret files the dev stack reads through `*_FILE` variables (never committed)
/secrets/

# mutmut working tree (mutation testing of scripts/ci, #161)
/mutants/

# coverage.py data file (mutation-python job, #161)
/.coverage
